[Unit]
Description=algo-lab pairs trading bot (Alpaca PAPER)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/algo-lab
ExecStart=/home/ubuntu/algo-lab/.venv/bin/python live_pairs.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
